# ChemBank — optional Supabase progress sync
# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings → API). Leave both empty to keep ChemBank fully local:
# the account menu stays hidden and no Supabase code is loaded.
#
# The anon key is public by design; it is only safe together with the
# row-level security policies in supabase/setup.sql. Never put a
# service_role key here — VITE_* vars are bundled into the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
